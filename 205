import csv
import io

RAW = """station,date,pm25
Adyar,2026-10-01,48
Adyar,2026-10-02,NA
Adyar,2026-10-03,
Guindy,2026-10-01,95
Guindy,2026-10-02,-5
Guindy,2026-10-03,121
"""

def load_clean(text):
    """Returns (station, date, pm25) tuples for valid, non-negative readings only."""
    rows = []
    f = io.StringIO(text.strip())
    reader = csv.DictReader(f)
    for row in reader:
        pm_str = row['pm25'].strip()
        # Skip if empty or 'NA'
        if not pm_str or pm_str.upper() == 'NA':
            continue
        try:
            pm_val = float(pm_str)
        except ValueError:
            continue
        
        # Skip negative values or values above 999 (as per assignment extension)
        if pm_val < 0 or pm_val > 999:
            continue
            
        rows.append((row['station'], row['date'], pm_val))
    return rows

def min_max(values):
    """Scale each value to the range 0-1 using (v - min) / (max - min), rounded to 3 decimals."""
    if not values:
        return []
    min_v = min(values)
    max_v = max(values)
    if min_v == max_v:
        return [0.0 for _ in values]
    return [round((v - min_v) / (max_v - min_v), 3) for v in values]

clean = load_clean(RAW)
print(clean)
print(min_max([pm for _, _, pm in clean]))
